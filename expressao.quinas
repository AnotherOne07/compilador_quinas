[ numero ObterFatorVento [] :
 [
	1,05
 ]
]

[ numero AplicarCorrecaoVento [numero alcance | numero ProvedorVento[]] :
 [
	alcance . Logaritmo[ProvedorVento[] + 9,0]
 ]
]

[ numero ProcessarFator [numero alc | numero Transformar[numero alcance | numero Provedor[]]] :
 [
	Transformar[alc | ObterFatorVento]
 ]
]

[ numero CalcularDistancia [numero angulo | numero velocidade] :
 [
	2,0 . <velocidade ´ 2,0> . Cosseno[angulo] . Seno[angulo] / 9,78216
 ]
]

[ numero BuscaTernaria [numero ini | numero fim | numero velocidade | numero passos] :
 [
	[
	 || < <passos == 0> v < <fim - ini> << 0,000001 > ^ ¬ <-velocidade >> 0,0> > = <ini + fim> / 2,0
	 || # = 
		[
		 [  numero PASSOSREDUZIDOS [passos // 2] ]
		 [  numero RESTOPASSOS [passos \ 2] ]
		 [  numero MUM [ini + <fim - ini> / 3,0] ]
		 [  numero MDOIS [fim - <fim - ini> / 3,0] ]
		 
		 [  numero DISTUM [ProcessarFator[CalcularDistancia[MUM | velocidade] | AplicarCorrecaoVento]] ]
		 [  numero DISTDOIS [ProcessarFator[CalcularDistancia[MDOIS | velocidade] | AplicarCorrecaoVento]] ]
		 
		 [
		  || <DISTUM << DISTDOIS> = BuscaTernaria[MUM | fim | velocidade | PASSOSREDUZIDOS + RESTOPASSOS]
		  || # = BuscaTernaria[ini | MDOIS | velocidade | PASSOSREDUZIDOS]
		 ]
		]
	]
 ]
]

++ [ numero Principal [] :
 [
	BuscaTernaria[0,0 | 1,571 | 30,0 | 20]
 ]
]